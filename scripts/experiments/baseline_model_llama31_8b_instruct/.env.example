# Model ablation: LLaMA-3.1-8B-Instruct with the full Self-Play method.
export EXPERIMENT_NAME="${EXPERIMENT_NAME:-model_llama31_8b_instruct}"

# TODO(user): fill in the LLaMA-3.1-8B-Instruct checkpoint directory.
export MODEL_PATH="${MODEL_PATH:-}"
