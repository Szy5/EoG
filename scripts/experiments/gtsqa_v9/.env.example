# Qwen2.5-7B SSP training on GTSQA v9. This profile uses the local mmap
# GTSQA index and must never start, stop, or probe Freebase Virtuoso.
_GTSQA_EXPERIMENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../baseline/.env.example
source "${_GTSQA_EXPERIMENT_DIR}/../baseline/.env.example"
unset _GTSQA_EXPERIMENT_DIR

export EXPERIMENT_NAME=kgqa_qwen25_7b_gtsqa_v9
export PROJECT_NAME=kgqa_selfplay_gtsqa_qwen25_7b
export OUTPUT_ROOT="${REPO_ROOT}/output/kgqa_qwen25_7b_gtsqa_v9"

export MODEL_PATH=/path/to/project/Qwen2.5-7B-Instruct
export TRAIN_PARQUET="${REPO_ROOT}/data/train/train_gtsqa_v9.parquet"
export VAL_PARQUET="${REPO_ROOT}/data/val/gtsqa/gtsqa_test.parquet"
export GENERATION_DATA_PATH="${REPO_ROOT}/data/train/train_gtsqa_v9.jsonl"

export KGQA_BACKEND=gtsqa
export KGQA_PROFILE_PATH="${REPO_ROOT}/configs/kg/profiles/gtsqa_training.yaml"
export GTSQA_INDEX_PATH="${REPO_ROOT}/data/database/kg-platform-gtsqa-index"
export ENABLE_LLM_RELATION_FILTER=False

export TRAIN_BATCH_SIZE=256
export VAL_BATCH_SIZE=128
export PPO_MINI_BATCH_SIZE=128
export MAX_PROMPT_LENGTH=2048
export MAX_RESPONSE_LENGTH=2560
export MAX_ASSISTANT_TURNS=15
export ROLLOUT_N=5
# The file contains exactly 120 ordered curriculum batches (30,720 / 256).
export TOTAL_TRAINING_STEPS=120
export TOTAL_EPOCHS=1
export VAL_BEFORE_TRAIN=FALSE
export RESUME_MODE=disable

export PROPOSER_ENABLE=True
export SOLVER_ENABLE=True
export PROPOSER_SYNTHESIS_MODE=kg_path
# Same post-proposer check as Freebase training: RAG Hit@1 on exploration triples.
export PROPOSER_RAG_FILTER=True
export PROPOSER_RAG_FAIL_OPEN=False
export RAG_MAX_WORKERS=300
