# Qwen2.5-7B SSP training on CarKGQA (car_train). Uses the local Car KG
# mmap index in embedded mode — never start Freebase Virtuoso for this profile.
#
# One machine:
#   KGQA_EXPERIMENT_CONFIG="$PWD/scripts/experiments/car_v1/.env.example" \
#     bash scripts/platforms/local.sh
#
# Config-only dry check (no Ray / training):
#   KGQA_CONFIG_ONLY=1 \
#   KGQA_EXPERIMENT_CONFIG="$PWD/scripts/experiments/car_v1/.env.example" \
#     bash scripts/platforms/local.sh
_CAR_EXPERIMENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../baseline/.env.example
source "${_CAR_EXPERIMENT_DIR}/../baseline/.env.example"
unset _CAR_EXPERIMENT_DIR

export EXPERIMENT_NAME=kgqa_qwen25_7b_car_v1
export PROJECT_NAME=kgqa_selfplay_car_qwen25_7b
export OUTPUT_ROOT="${REPO_ROOT}/output/kgqa_qwen25_7b_car_v1"
export MODEL_PATH="${MODEL_PATH:-/path/to/project/Qwen2.5-7B-Instruct}"

export TRAIN_PARQUET="${REPO_ROOT}/data/train/car_train.parquet"
export GENERATION_DATA_PATH="${REPO_ROOT}/data/train/car_train.jsonl"
# Solver-format carbench (500), same Arrow contract as data/val/val_webqsp.parquet.
export VAL_PARQUET="${REPO_ROOT}/data/val/val_carbench.parquet"
export VAL_WEBQSP_PARQUET="${VAL_PARQUET}"
export VAL_CWQ_PARQUET="${VAL_PARQUET}"

export KGQA_BACKEND=car
export KGQA_PROFILE_PATH="${REPO_ROOT}/configs/kg/profiles/car_kg_training.yaml"
export CAR_KG_INDEX_PATH="${CAR_KG_INDEX_PATH:-${REPO_ROOT}/data/database/kg-platform-car-kg-index}"
export ENABLE_LLM_RELATION_FILTER=False

# 3300 train rows / 100 = 33 exact curriculum steps.
export TRAIN_BATCH_SIZE=100
export VAL_BATCH_SIZE=50
export PPO_MINI_BATCH_SIZE=50
export MAX_PROMPT_LENGTH=2048
export MAX_RESPONSE_LENGTH=2560
export MAX_ASSISTANT_TURNS=15
export ROLLOUT_N=5
export TOTAL_TRAINING_STEPS=60
export TOTAL_EPOCHS=2
export SAVE_FREQ=11
export TEST_FREQ=11
export VAL_BEFORE_TRAIN=FALSE
export RESUME_MODE=disable

export PROPOSER_ENABLE=True
export SOLVER_ENABLE=True
export PROPOSER_SYNTHESIS_MODE=kg_path
# Same post-proposer check as GTSQA v9: RAG Hit@1 on exploration triples.
export PROPOSER_RAG_FILTER=True
export PROPOSER_RAG_FAIL_OPEN=False
export RAG_MAX_WORKERS=300
