# Qwen2.5-3B SSP training using the same GTSQA v9 recipe as gtsqa_v9/.env.example.
_GTSQA_V9_MODEL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../gtsqa_v9/.env.example
source "${_GTSQA_V9_MODEL_DIR}/../gtsqa_v9/.env.example"
unset _GTSQA_V9_MODEL_DIR

export EXPERIMENT_NAME=kgqa_qwen25_3b_gtsqa_v9
export PROJECT_NAME=kgqa_selfplay_gtsqa_qwen25_3b
export OUTPUT_ROOT="${REPO_ROOT}/output/kgqa_qwen25_3b_gtsqa_v9"
export MODEL_PATH=/path/to/Qwen2.5-3B-Instruct
export CHAT_TEMPLATE_MODE=qwen2p5
