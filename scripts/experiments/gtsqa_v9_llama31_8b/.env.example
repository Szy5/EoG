# Llama-3.1-8B-Instruct SSP training using the GTSQA v9 recipe.
_GTSQA_V9_MODEL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../gtsqa_v9/.env.example
source "${_GTSQA_V9_MODEL_DIR}/../gtsqa_v9/.env.example"
unset _GTSQA_V9_MODEL_DIR

export EXPERIMENT_NAME=kgqa_llama31_8b_gtsqa_v9
export PROJECT_NAME=kgqa_selfplay_gtsqa_llama31_8b
export OUTPUT_ROOT="${REPO_ROOT}/output/kgqa_llama31_8b_gtsqa_v9"
export MODEL_PATH=/path/to/project/Llama-3.1-8B-Instruct
export CHAT_TEMPLATE_MODE=llama3p1_react_inline
