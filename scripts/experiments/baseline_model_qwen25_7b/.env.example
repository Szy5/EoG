# Model ablation: Qwen-2.5-7B-Instruct with the full Self-Play method.
export EXPERIMENT_NAME="${EXPERIMENT_NAME:-ablation_model_qwen25_7b}"
export MODEL_PATH="${MODEL_PATH:-/path/to/project/Qwen2.5-7B-Instruct}"

export VAL_BEFORE_TRAIN="${VAL_BEFORE_TRAIN:-FALSE}"
export ENTROPY_COEFF="${ENTROPY_COEFF:-0}"
export PROPOSER_ADV_ESTIMATOR="${PROPOSER_ADV_ESTIMATOR:-grpo}"
export PROPOSER_BASELINE_KEY="${PROPOSER_BASELINE_KEY:-uid}"

export PROPOSER_ENABLE="${PROPOSER_ENABLE:-True}"
export SOLVER_ENABLE="${SOLVER_ENABLE:-True}"
export PROPOSER_SYNTHESIS_MODE="${PROPOSER_SYNTHESIS_MODE:-kg_path}"
export PROPOSER_RAG_FILTER="${PROPOSER_RAG_FILTER:-True}"
